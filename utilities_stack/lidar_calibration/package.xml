<?xml version="1.0"?>
<package format="2">
  <name>lidar_calibration</name>
  <version>0.0.1</version>
  <description>Calibração da covariância de medições de beacons do LiDAR</description>
  <maintainer email="afonso@exemplo.com">Afonso</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>localizer</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>localizer</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>libyaml-cpp-dev</exec_depend>

  <export>
  </export>
</package>


