<launch>

	<!-- Argumentos configuráveis -->
	<arg name="map_file" default="$(find conf)/launch/hmi/maps/factory_map.yaml"/>
	<arg name="rviz_config" default="$(find conf)/launch/hmi/fdpo_simulation.rviz"/>
	<arg name="lidar_driver" default="ydlidar" doc="Escolha o driver de LiDAR: 'hlds' ou 'ydlidar'"/>
	<arg name="debug_pico_comm" default="false" doc="Mostrar logs de comunicação Pi4-Pico (throttle no driver)"/>
	<arg name="pico_robot_id" default="0" doc="ROBOT_ID no Pico (0-based); handshake série"/>
	<arg name="pico_num_robots" default="3" doc="NUM_ROBOTS no firmware (2–4); handshake série"/>
	<arg name="use_ekf" default="true" doc="Usar EKF localizer com beacons (se false, map=odom, só odometria)"/>
	<arg name="use_raw_odom" default="false" doc="Usar odometria pura (/odom) em vez de filtrada. Só funciona quando use_ekf=false"/>
	<arg name="use_ss_controller" default="false" doc="Usar state space controller (true) ou controlador original (false)"/>
	<arg name="use_hal" default="true"/>
	<arg name="use_navigation" default="true"/>
	<arg name="use_hmi" default="true"/>
	<arg name="use_rviz" default="false" doc="Ativar RViz automaticamente"/>
	<arg name="use_planner" default="true" />
	<arg name="planner_node_name" default="chris_planner_node" />
	<arg name="planning_method" default="astar" doc="Planning method for chris_planner: closest, onebyone, greedy_h, or astar"/>
	<arg name="use_wifi" default="true" />
	<arg name="planner_type" default="chris" doc="chris ou multi"/>
	<arg name="robot_id" default="0" doc="ID do robo para comunicacoes (0-based); sobrescrito pelo initializer via args"/>
	<arg name="spawn_manga" default="manga_1" doc="EKF: robot_spawns em missions.yaml (antes da missão)"/>

	<!-- HAL: Hardware Abstraction Layer (LiDAR, etc) -->
	<include if="$(arg use_hal)" file="$(find conf)/system/hal.xml">
		<arg name="lidar_driver" value="$(arg lidar_driver)"/>
		<arg name="debug_pico_comm" value="$(arg debug_pico_comm)"/>
		<arg name="pico_robot_id" value="$(arg pico_robot_id)"/>
		<arg name="pico_num_robots" value="$(arg pico_num_robots)"/>
	</include>

	<!-- Navigation: Localização e Controle de Navegação -->
	<include if="$(arg use_navigation)" file="$(find conf)/system/navigation.xml">
		<arg name="lidar_driver" value="$(arg lidar_driver)"/>
		<arg name="use_ekf" value="$(arg use_ekf)"/>
		<arg name="use_raw_odom" value="$(arg use_raw_odom)"/>
		<arg name="use_ss_controller" value="$(arg use_ss_controller)"/>
		<arg name="robot_id" value="$(arg robot_id)" />
		<arg name="num_robots" value="$(arg pico_num_robots)" />
		<arg name="spawn_manga" value="$(arg spawn_manga)" />
	</include>
    
	<!-- HMI: Interface Humano-Máquina (Mapa, RViz, etc) -->
	<include if="$(arg use_hmi)" file="$(find conf)/system/hmi.xml">
		<arg name="map_file" value="$(arg map_file)"/>
		<arg name="rviz_config" value="$(arg rviz_config)"/>
		<arg name="use_rviz" value="$(arg use_rviz)"/>
	</include>

	<include if="$(arg use_planner)" file="$(find conf)/system/planner.xml">
		<arg name="planner_type" value="$(arg planner_type)" />
		<arg name="node_name" value="$(eval 'chris_planner_node' if arg('planner_type') == 'chris' else 'multi_planner_node')" />
		<arg name="planning_method" value="$(arg planning_method)" />
		<arg name="planner_executable" value="$(eval 'chris_planner_node' if arg('planner_type') == 'chris' else 'multi_planner_node')" />
		<arg name="robot_id" value="$(arg robot_id)" />
	</include>
		
	<include file="$(find conf)/system/wifi.xml">
		<arg name="enable" value="$(arg use_wifi)" />
	</include>
	
</launch>
