<launch>
  
  <arg name="planned_paths_topic" default="/planned_paths" doc="Topic to subscribe for planned paths (Int32MultiArray)"/>
  <arg name="queue_size" default="100" doc="Queue size for subscriber"/>

  <!-- Carrega coordenadas da fábrica no Parameter Server antes do nó -->
  <!-- O C++ lê via nh.getParam("factory_coords", ...), que procura o parâmetro global /factory_coords -->
  <rosparam file="$(find plan_handler)/config/factory_coordinates.yaml" command="load"/>

  <node pkg="plan_handler" type="plan_handler_node" name="plan_handler_node" output="screen">
    <param name="planned_paths_topic" value="$(arg planned_paths_topic)"/>
    <param name="queue_size" value="$(arg queue_size)"/>
  </node>

</launch>

