<launch>
  
  <arg name="planned_paths_topic" default="/planned_paths" doc="Topic to subscribe for planned paths (Int32MultiArray)"/>
  <arg name="queue_size" default="100" doc="Queue size for subscriber"/>
  <arg name="robot_id" default="0" doc="Índice 0-based; usa factory_coordinates_robot0/1/2.yaml"/>
  <!-- Caminho base para seleção por robot_id 0-based -->
  <arg name="factory_coords_yaml_base" value="$(find plan_handler)/config/factory_coordinates_robot"/>

  <!-- Mesmo ficheiro que navigation.xml (idempotente se já carregado) -->
  <rosparam file="$(find conf)/launch/navigation/navigation_controller/follow_line_parameters.yaml" command="load" ns="/follow_line"/>

  <!-- Carrega coordenadas da fábrica no Parameter Server antes do nó -->
  <!-- O C++ lê via nh.getParam("factory_coords", ...), que procura o parâmetro global /factory_coords -->
  <rosparam file="$(eval arg('factory_coords_yaml_base') + str(int(str(arg('robot_id')).strip())) + '.yaml')" command="load"/>

  <node pkg="plan_handler" type="plan_handler_node" name="plan_handler_node" output="screen">
    <param name="planned_paths_topic" value="$(arg planned_paths_topic)"/>
    <param name="queue_size" value="$(arg queue_size)"/>
  </node>

</launch>

