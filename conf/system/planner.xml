<launch>
  <arg name="node_name" default="chris_planner_node" />
  <arg name="planning_method" default="astar" />
  <arg name="planner_executable" default="chris_planner_node" />
  <arg name="robot_id" default="1" />

  <include file="$(find chris_planner)/launch/chris_planner.launch">
    <arg name="node_name" value="$(arg node_name)" />
    <arg name="planning_method" value="$(arg planning_method)" />
    <arg name="planner_executable" value="$(arg planner_executable)" />
    <arg name="robot_id" value="$(arg robot_id)" />
  </include>
</launch>
