<launch>
  <!--
    Wrapper de sistema para o initializer_node, seguindo a convencao de
    conf/system/*.xml. Outros ficheiros (ex. hal.xml, navigation.xml) NAO
    devem incluir este: o initializer e arrancado pelo bootstrap.launch
    de forma isolada.
  -->
  <arg name="params_file"
       default="$(find fdpo_initializer)/config/initializer_params.yaml"/>

  <include file="$(find fdpo_initializer)/launch/run_initializer.launch">
    <arg name="params_file" value="$(arg params_file)"/>
  </include>
</launch>
