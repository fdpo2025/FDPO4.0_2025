<launch>
  <!-- =========================
       Configuração geral
       ========================= -->
  <arg name="port" default="/dev/ttyUSB0"/>
  <arg name="baud" default="128000"/>

  <arg name="scan_topic" default="/scan"/>
  <arg name="cloud_topic" default="/laser_scan_point_cloud"/>

  <!-- Frame do laser -->
  <arg name="frame_id" default="laser"/>

  <!-- =========================
       Pose do laser no robô
       (METROS e RADIANOS)
       ========================= -->
  <arg name="laser_x" default="0.0"/>
  <arg name="laser_y" default="0.0"/>
  <arg name="laser_z" default="0.0"/>

  <!-- 180 graus = pi rad -->
  <arg name="laser_yaw"   default="3.14159265"/>
  <arg name="laser_pitch" default="0.0"/>
  <arg name="laser_roll"  default="0.0"/>

  <!-- =========================
       1) Driver YDLidar X4 (SDK)
       ========================= -->
  <node pkg="sdpo_driver_laser_2d"
        type="ydlidar_x4_sdk_node"
        name="ydlidar_x4"
        output="screen">

    <param name="port" value="$(arg port)"/>
    <param name="baudrate" value="$(arg baud)"/>
    <param name="frame_id" value="$(arg frame_id)"/>

    <!-- Se o teu node publica LaserScan -->
    <remap from="/scan" to="$(arg scan_topic)"/>
  </node>

  <!-- =========================
       2) TF estático base_link → laser
       (ISTO É O QUE FALTAVA)
       ========================= -->
  <node pkg="tf"
        type="static_transform_publisher"
        name="base_link_to_laser_tf"
        args="
          $(arg laser_x)
          $(arg laser_y)
          $(arg laser_z)
          $(arg laser_yaw)
          $(arg laser_pitch)
          $(arg laser_roll)
          base_link
          $(arg frame_id)
          100" />

</launch>
