<launch>

  <arg name="node_name" default="chris_planner_node" />
  <arg name="planning_method" default="closest" />
  <arg name="robot_id" default="0" doc="Índice 0-based (igual Pico); 0 hub, 1 secundário (multi)"/>
  <arg name="planner_executable" default="chris_planner_node" />
  <arg name="launch_planner" default="true" doc="false: não arranca chris_planner_node / multi_planner_node"/>
  <arg name="launch_comunicacoes" default="true" doc="false: não arranca comunicacoes_node (menos ruído no terminal)"/>

  <!-- Planner -->
  <!-- arg('launch_planner') pode vir como bool True/False ou string 'true'/'false'; True == 'true' falha em Python -->
  <node if="$(eval str(arg('launch_planner')).lower() in ('true', '1'))"
        name="$(arg node_name)"
        pkg="chris_planner"
        type="$(arg planner_executable)"
        output="screen">
    <param name="planning_method" value="$(arg planning_method)" />
  </node>

  <!-- Communications -->
  <node if="$(eval str(arg('launch_comunicacoes')).lower() in ('true', '1'))"
        name="comunicacoes_planner"
        pkg="chris_planner"
        type="comunicacoes_node"
        output="screen">
    <param name="robot_id" value="$(arg robot_id)" />
  </node>

</launch>
