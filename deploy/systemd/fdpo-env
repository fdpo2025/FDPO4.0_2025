# Variáveis de ambiente partilhadas pelas units do stack FDPO.
#
# Copiar para /etc/fdpo/env (fora do repo) e ajustar por robô.
#   sudo install -d -m 0755 /etc/fdpo
#   sudo cp fdpo-env /etc/fdpo/env
#   sudo $EDITOR /etc/fdpo/env
#
# ID do robô (0..3). Cada Pi tem de ter o seu.
FDPO_ROBOT_ID=0

